<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>
<?import java.net.URL?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProyectoFinal_Gimnasio.ViewController.AdminViewController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 10;">
            <Label styleClass="label-titulo" text="Panel del Administrador" />
            <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="10.0">
                <Label fx:id="adminNameLabel" text="Bienvenido, Admin" />
                <Button onAction="#cerrarSesion" text="Cerrar Sesión" />
            </HBox>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Gestión de Entrenadores">
                    <content>
                        <HBox spacing="20.0" style="-fx-padding: 20;">
                            <VBox fx:id="entrenadorInputVBox" spacing="10.0" prefWidth="300.0">
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Registro/Edición de Entrenador" />
                                <TextField fx:id="nombreField" promptText="Nombre" />
                                <TextField fx:id="idField" promptText="Identificación" />
                                <TextField fx:id="telefonoField" promptText="Teléfono" />
                                <TextField fx:id="salarioField" promptText="Salario" />
                                <TextField fx:id="especialidadField" promptText="Especialidad" />
                                <HBox spacing="10.0">
                                    <Button onAction="#registrarEntrenador" text="Registrar" />
                                    <Button onAction="#modificarEntrenador" text="Modificar" />
                                    <Button onAction="#eliminarEntrenador" text="Eliminar" />
                                </HBox>
                            </VBox>
                            <TableView fx:id="entrenadoresTable" HBox.hgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="nombreColumn" prefWidth="150.0" text="Nombre" />
                                    <TableColumn fx:id="idColumn" prefWidth="120.0" text="Identificación" />
                                    <TableColumn fx:id="telefonoColumn" prefWidth="120.0" text="Teléfono" />
                                    <TableColumn fx:id="salarioColumn" prefWidth="100.0" text="Salario" />
                                    <TableColumn fx:id="especialidadColumn" prefWidth="150.0" text="Especialidad" />
                                </columns>
                            </TableView>
                        </HBox>
                    </content>
                </Tab>
                <Tab text="Gestión de Clases">
                    <content>
                        <HBox spacing="20.0" style="-fx-padding: 20;">
                            <VBox fx:id="claseInputVBox" spacing="10.0" prefWidth="300.0">
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Registro/Edición de Clase" />
                                <TextField fx:id="claseNombreField" promptText="Nombre de la Clase" />
                                <ComboBox fx:id="claseTipoBox" prefWidth="300.0" promptText="Tipo de Clase" />
                                <TextField fx:id="claseHorarioField" promptText="Horario (HH:mm)" />
                                <TextField fx:id="claseCupoField" promptText="Cupo Máximo" />
                                <ComboBox fx:id="claseEntrenadorBox" prefWidth="300.0" promptText="Entrenador" />
                                <HBox spacing="10.0">
                                    <Button onAction="#registrarClase" text="Registrar" />
                                    <Button onAction="#modificarClase" text="Modificar" />
                                    <Button onAction="#eliminarClase" text="Eliminar" />
                                </HBox>
                            </VBox>
                            <TableView fx:id="clasesTable" HBox.hgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="claseNombreColumn" prefWidth="150.0" text="Nombre" />
                                    <TableColumn fx:id="claseTipoColumn" prefWidth="100.0" text="Tipo" />
                                    <TableColumn fx:id="claseHorarioColumn" prefWidth="100.0" text="Horario" />
                                    <TableColumn fx:id="claseCupoColumn" prefWidth="80.0" text="Cupo" />
                                    <TableColumn fx:id="claseEntrenadorColumn" prefWidth="150.0" text="Entrenador" />
                                </columns>
                            </TableView>
                        </HBox>
                    </content>
                </Tab>
                <Tab text="Reportes Avanzados">
                    <content>
                        <HBox spacing="20.0" style="-fx-padding: 20;">
                            <VBox spacing="10.0" prefWidth="300.0">
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Generar Reportes" />
                                <Button onAction="#generarReporteAsistencia" text="Asistencia a Clases" />
                                <Button onAction="#generarReporteIngresos" text="Ingresos por Membresías" />
                                <Button onAction="#generarReporteClasesPopulares" text="Clases Más Populares" />
                            </VBox>
                            <TextArea fx:id="reporteTextArea" HBox.hgrow="ALWAYS" editable="false" wrapText="true" />
                        </HBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
